# Enable features needed for the keymap

# One Shot Keys for sticky modifiers
ONESHOT_ENABLE = yes

# Tri Layer support for conditional layers
TRI_LAYER_ENABLE = yes

# Optional: Uncomment if you want to use QMK's combo feature
# COMBO_ENABLE = yes

# Optional: Uncomment for key override support
# KEY_OVERRIDE_ENABLE = yes

# Shared endpoint for Globe key modifier combos
KEYBOARD_SHARED_EP = yes
